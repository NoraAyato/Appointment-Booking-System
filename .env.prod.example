# Docker image published by the CI pipeline.
APP_IMAGE=ghcr.io/your-github-username/appointment-booking-system
APP_VERSION=latest
APP_HOST_PORT=8080

# Spring profile.
SPRING_PROFILES_ACTIVE=prod

# JWT. Use long random strings and keep them stable between deploys.
SECURITY_JWT_SECRET=change-this-access-token-secret-at-least-32-bytes
SECURITY_JWT_RESET_SECRET=change-this-reset-token-secret-at-least-32-bytes
SECURITY_JWT_EXPIRATION=3600000
SECURITY_JWT_REFRESH_EXPIRATION=259200000
SECURITY_JWT_RESET_EXPIRATION=3600000

# MySQL.
MYSQL_DATABASE=appointment_booking
MYSQL_USER=appointment_user
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Redis.
REDIS_PASSWORD=change-this-redis-password

# Mail.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=change-this-mail-app-password

# Google OAuth.
GOOGLE_OAUTH_CLIENT_ID=change-this-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=change-this-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/google/callback

# MoMo payment gateway.
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_REDIRECT_URL=http://localhost:5173/payment/result
MOMO_IPN_URL=https://suffering-slider-anybody.ngrok-free.dev/api/payments/momo/ipn
MOMO_REQUEST_TYPE=captureWallet

# Unpaid invoice expiration scheduler.
PAYMENT_EXPIRATION_FIXED_DELAY_MS=60000    # Interval between each run (ms), default 60s
PAYMENT_EXPIRATION_INITIAL_DELAY_MS=60000  # Delay after app startup before first run (ms)
PAYMENT_EXPIRATION_MINUTES=15             # Cancel invoices unpaid for this many minutes
PAYMENT_EXPIRATION_BATCH_SIZE=500         # Max invoices processed per run
